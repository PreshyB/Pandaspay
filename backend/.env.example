PORT=3000

# Either set DATABASE_URL, or the discrete DB_* vars below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=pandaspay
DB_PASSWORD=pandaspay
DB_NAME=pandaspay
# true only for local dev — migrations drive the schema everywhere else.
DB_SYNCHRONIZE=true

REDIS_URL=redis://localhost:6379

# --- Sign-in (email one-time code) ---
# Required in production. Any long random string.
AUTH_SECRET=
# When false, requests without a token are still accepted (needed while the mobile app has no sign-in).
# Always enforced in production. Set true to test real permissions in dev.
AUTH_ENFORCED=false
# Dev only: return the one-time code in the API response, since no email provider is wired up yet.
AUTH_DEV_OTP=true
# Comma-separated emails that become admins when they sign in.
ADMIN_EMAILS=

# Sellers request payouts and an admin approves. true = pay out automatically (local testing only).
AUTO_PAYOUT=false
